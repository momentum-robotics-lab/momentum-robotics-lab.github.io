---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Layout from "../layouts/Layout.astro";
import { siteConfig } from "../config";
import { getLabPublications } from "../utils/publications";

const publications = await getLabPublications();
const years = [...new Set(publications.map((pub) => pub.year))].sort(
  (a, b) => Number(b) - Number(a),
);
const scholarUrl = siteConfig.members.principalInvestigator.googleScholar;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: `Publications | ${siteConfig.name}`,
  url: new URL("/publications", siteConfig.url).href,
  description:
    "Papers from CMU's Momentum Lab on dexterous manipulation, soft robotics, 3D vision, and robot learning.",
  isPartOf: {
    "@type": "ResearchOrganization",
    name: siteConfig.name,
    url: siteConfig.url,
  },
};
---

<Layout
  title={`Publications | ${siteConfig.name}`}
  description="Papers from CMU's Momentum Lab on dexterous manipulation, soft robotics, 3D vision, and robot learning, including NeurIPS, IROS, and arXiv preprints."
  jsonLd={jsonLd}
>
  <Header />
  <main class="min-h-screen bg-white">
    <div class="max-w-4xl mx-auto px-6 sm:px-8 pt-12 md:pt-32 pb-20 md:pb-28">
      <header class="mb-12 md:mb-16">
        <h1 class="text-4xl sm:text-5xl font-bold text-gray-900 tracking-tight">
          Publications
        </h1>
        <div
          class="w-[75px] h-[5px] mt-3 rounded-full"
          style={`background-color: ${siteConfig.accentColor}`}
        />
        <p class="mt-6 text-base sm:text-lg text-gray-600 leading-relaxed max-w-2xl">
          Papers from the Momentum Lab since 2023, when Jeffrey Ichnowski joined Carnegie Mellon University's Robotics Institute.
        </p>
        <p class="mt-3 text-sm sm:text-base text-gray-500 leading-relaxed max-w-2xl">
          This listing is a snapshot and may lag behind new preprints. For the most recent papers, check{" "}
          <a
            href={scholarUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="font-medium underline underline-offset-2 hover:text-gray-800 transition-colors"
            style={`color: ${siteConfig.accentColor}`}
          >
            Jeffrey Ichnowski's Google Scholar
          </a>.
        </p>
      </header>

      <div class="space-y-14">
        {
          years.map((year) => (
            <section>
              <h2
                class="text-sm font-semibold tracking-[0.18em] uppercase pb-3 mb-6 border-b border-gray-200"
                style={`color: ${siteConfig.accentColor}`}
              >
                {year}
              </h2>
              <ul class="space-y-8">
                {publications
                  .filter((pub) => pub.year === year)
                  .map((pub) => (
                    <li>
                      <h3 class="text-base sm:text-lg font-semibold text-gray-900 leading-snug">
                        <a
                          href={pub.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="hover:text-blue-700 transition-colors"
                        >
                          {pub.title}
                        </a>
                      </h3>
                      <p class="text-sm text-gray-600 mt-2 leading-relaxed">
                        {pub.authors}
                      </p>
                      <p class="text-sm text-gray-500 mt-1 leading-relaxed">
                        {pub.venue}
                      </p>
                    </li>
                  ))}
              </ul>
            </section>
          ))
        }
      </div>
    </div>
  </main>
  <Footer />
</Layout>

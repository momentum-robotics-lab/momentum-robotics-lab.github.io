---
import { siteConfig } from "../config";
import { getRecentLabPublications } from "../utils/publications";

const publications = await getRecentLabPublications(12);
---

{
  publications.length > 0 && (
    <section id="publications" class="p-8 sm:p-12 md:p-16 lg:p-24">
      <div>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
          <div class="lg:col-span-4">
            <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-gray-900">
              Publications
            </h2>
            <div
              class="w-[75px] h-[5px] mt-2 rounded-full"
              style={`background-color: ${siteConfig.accentColor}`}
            />
            <p class="mt-6 text-gray-600 leading-relaxed">
              Recent papers from the lab on dexterous manipulation, soft robotics, 3D vision, and robot learning.
            </p>
          </div>

          <div class="lg:col-span-8">
            <div class="space-y-5">
              {publications.map((pub) => (
                <article class="border-l-4 pl-4 py-1" style={`border-color: ${siteConfig.accentColor}`}>
                  <h3 class="font-semibold text-gray-900">
                    <a
                      href={pub.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="hover:text-blue-600 transition-colors"
                    >
                      {pub.title}
                    </a>
                  </h3>
                  <p class="text-sm text-gray-600 mt-1">{pub.authors}</p>
                  <p class="text-sm text-gray-500 mt-1">
                    <span class="font-medium">{pub.venue}</span>
                    {pub.year ? ` · ${pub.year}` : ""}
                  </p>
                </article>
              ))}
            </div>
            <a
              href="/publications"
              class="inline-flex items-center gap-2 mt-8 text-sm font-medium hover:underline"
              style={`color: ${siteConfig.accentColor}`}
            >
              View all publications
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  )
}
